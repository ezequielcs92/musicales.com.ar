{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "musicales",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "musicales"
    }
  ],
  "observability": {
    "enabled": true
  },

  // Subdominio *.workers.dev para probar antes de exponer el dominio real.
  // Se apaga cuando el sitio ya vive en musicales.com.ar, para no tener el
  // mismo contenido en dos direcciones indexables.
  "workers_dev": true

  // Dominio propio. Descomentar despues del primer despliegue exitoso, cuando
  // ya se comprobo que el worker levanta. Requiere que la zona este en la
  // misma cuenta de Cloudflare, cosa que ya se cumple: los nameservers de
  // musicales.com.ar apuntan a Cloudflare.
  //
  // "routes": [
  //   { "pattern": "musicales.com.ar", "custom_domain": true }
  // ],
  //
  // `www` NO se agrega como segunda ruta: serviria el mismo contenido en dos
  // direcciones y eso es contenido duplicado. Va como regla de redireccion 301
  // desde el panel de Cloudflare, hacia el dominio sin www.

  // ---------------------------------------------------------------------
  // Pendiente de fase 0. Descomentar a medida que existan los recursos.
  //
  // Buckets R2. El primero lo usa OpenNext para el caché incremental de ISR;
  // verificar el nombre exacto del binding contra la version instalada de
  // @opennextjs/cloudflare antes de activarlo.
  //
  // "r2_buckets": [
  //   { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "musicales-cache" },
  //   { "binding": "MEDIA", "bucket_name": "musicales-media" }
  // ],
  //
  // Tarea diaria: mantiene despierto el proyecto de Supabase, que en plan
  // gratuito se pausa tras una semana sin actividad.
  //
  // "triggers": { "crons": ["17 6 * * *"] }
  // ---------------------------------------------------------------------
}
