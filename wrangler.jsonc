{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "musicales",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "musicales"
    }
  ],
  "observability": {
    "enabled": true
  },

  // Solo medios. El binding del caché incremental
  // (NEXT_INC_CACHE_R2_BUCKET) está fuera a propósito: al declararlo, el
  // despliegue precarga el caché objeto por objeto y esas escrituras no
  // completan desde esta conexión. Ver open-next.config.ts.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "musicales-media" }
  ],

  // Sin subdominio *.workers.dev: registrarlo requiere una terminal
  // interactiva y el sitio va directo al dominio real, que ya tiene el DNS
  // delegado a Cloudflare.
  "workers_dev": false,

  // `www` NO va como segunda ruta: serviria el mismo contenido en dos
  // direcciones indexables, y eso es contenido duplicado. Va como regla de
  // redireccion 301 desde el panel de Cloudflare, hacia el dominio sin www.
  "routes": [{ "pattern": "musicales.com.ar", "custom_domain": true }]

}
