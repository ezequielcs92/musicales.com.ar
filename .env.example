# ---------------------------------------------------------------------------
# Musicales.com.ar — variables de entorno
#
# Copiar a `.env.local` y completar. `.env.local` esta ignorado por git y NUNCA
# se commitea. Este archivo solo lleva los nombres, jamas los valores.
#
# Dos archivos, dos runtimes:
#   .env.local   -> lo lee `next dev`
#   .dev.vars    -> lo lee `wrangler dev` y `npm run preview` (el worker real)
# Mantener los dos en sincronia mientras se desarrolla.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Panel del proyecto -> Project Settings -> API keys

# Publica: viaja al navegador a proposito. La protege el RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA: saltea todo el RLS. Solo en el servidor.
# En produccion NO va aca: se carga con `wrangler secret put`.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sitio ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://musicales.com.ar

# Dominio propio del bucket R2 de medios. El `r2.dev` publico esta limitado
# y Cloudflare desaconseja usarlo en produccion.
NEXT_PUBLIC_MEDIA_URL=https://img.musicales.com.ar

# --- AdSense --------------------------------------------------------------
# Se completa recien en la fase 4, despues de la aprobacion.
NEXT_PUBLIC_ADSENSE_CLIENT=

# --- Search Console ---------------------------------------------------------
# Token de verificacion por etiqueta HTML. No es secreto: viaja en el HTML.
# Se saca de Search Console -> Agregar propiedad -> Prefijo de URL -> Etiqueta HTML.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
